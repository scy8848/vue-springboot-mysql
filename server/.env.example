NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
DATABASE_URL="mysql://root:password@localhost:3306/mori_market"
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN=7d

# Optional SMTP. If omitted in development, the code is logged and returned by the API.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM="MORI 森集 <no-reply@example.com>"
